{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shou-lxk",
  "account_id": "15ce34fcf3c0f4fc58e57f5d7cc10c21",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shou-courses",
      "database_id": "9e6f10ee-4e0b-4b8c-8662-b598ba79f3ba",
    },
  ],
  "workers_dev": false,
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFMgPNoCPDd8BWht",
    "OIDC_ISSUER": "https://auth.shoumc.com/api/auth",
    "OIDC_CLIENT_ID": "shou-lxk-production",
    "OIDC_REDIRECT_URI": "https://lxk.shoumc.com/auth/callback",
    "OIDC_ALLOW_LOCAL_HTTP": "false",
  },
  "routes": [{ "pattern": "lxk.shoumc.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
  },
}
