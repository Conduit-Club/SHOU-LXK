{
  "name": "course-critic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node scripts/test-http-permissions.mjs",
    "benchmark:d1": "node scripts/benchmark-d1.mjs",
    "benchmark:pages": "node scripts/benchmark-pages.mjs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "cn": "^0.3.3",
    "openid-client": "^6.8.8",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
